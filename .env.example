# Optional: Gemini API key for live Gemini 3.5 Flash-Lite streaming in /api/coach.
# If omitted, OWLChess uses its built-in deterministic grounded coach engine.
GEMINI_API_KEY=

# Optional: Override the default Gemini model (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Lichess API token for higher rate limits on explorer.lichess.ovh/masters
LICHESS_API_TOKEN=
